{
  "name": "zenid-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial ZEN ID CLI",
  "type": "module",
  "bin": { "zenid": "dist/bin.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "commander": "^14.0.0", "playwright": "^1.56.0" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
